backend/benchmark_equity.py
*.md
!README.md

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# OS files
.DS_Store
Thumbs.db

# Documentation (except README)
docs/
development_notes.md

# Local environment
.env.local
.env.*.local
venv/
.venv/

# Coverage reports
htmlcov/
.coverage
coverage/

